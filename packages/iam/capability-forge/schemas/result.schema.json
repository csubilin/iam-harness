{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iax.capability.result/1",
  "title": "IAX capability result",
  "description": "The single source of truth a report renders from. Every number is stored as a RAW VALUE WITH A UNIT; this file never contains a formatted string such as '104.41' or '1.04 x 10^8'. Changing how a value is displayed changes the report spec, not this file.",
  "type": "object",
  "required": [
    "schema", "capability", "version", "run", "inputs", "parameters", "units",
    "frame", "versions", "facts", "solids", "metrics", "verdicts", "artifacts", "warnings"
  ],
  "properties": {
    "schema": { "const": "iax.capability.result/1" },
    "capability": {
      "type": "string",
      "minLength": 1,
      "description": "The capability name, e.g. orebody-model."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "The capability version, so a result can be attributed to the contract that produced it."
    },
    "run": {
      "type": "object",
      "required": ["id", "started", "duration_s"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "started": { "type": "string", "minLength": 1 },
        "duration_s": { "type": "number", "minimum": 0 },
        "steps": {
          "type": "object",
          "description": "Which steps this run was asked for, which ran, and which were skipped. A partial run says so here instead of looking like a full one.",
          "properties": {
            "requested": { "type": "array", "items": { "type": "string" } },
            "executed": { "type": "array", "items": { "type": "string" } },
            "skipped": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "object",
      "description": "Every input that was read, with its sha256. An input that cannot be hashed must say so rather than be omitted."
    },
    "parameters": {
      "type": "object",
      "description": "EVERY parameter used, including defaults. Three months later this is the only answer to 'why is this volume different'."
    },
    "units": {
      "type": "object",
      "required": ["length", "volume", "mass", "unit_to_meters"],
      "properties": {
        "length": { "type": "string", "minLength": 1 },
        "volume": { "type": "string", "minLength": 1 },
        "mass": { "type": "string", "minLength": 1 },
        "unit_to_meters": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "frame": {
      "type": "object",
      "required": ["label", "origin", "rotation_deg"],
      "properties": {
        "label": { "type": "string" },
        "origin": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "rotation_deg": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
      },
      "additionalProperties": true
    },
    "versions": {
      "type": "object",
      "required": ["platform", "catalog", "algorithm", "abi", "python"],
      "description": "The attribution triple. A null means the platform could not answer it; null is not a version.",
      "properties": {
        "platform": { "type": "string" },
        "catalog": { "type": ["integer", "null"] },
        "algorithm": { "type": ["integer", "null"] },
        "abi": { "type": ["integer", "null"] },
        "python": { "type": "string" }
      },
      "additionalProperties": true
    },
    "facts": {
      "type": "object",
      "description": "P0 facts read from the data (counts, extents, material names), so the report does not have to recompute them."
    },
    "solids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["material", "volume_m3", "triangle_count", "shell_count", "closed_manifold"],
        "properties": {
          "material": { "type": "string", "minLength": 1 },
          "volume_m3": {
            "type": "number",
            "description": "RAW cubic metres. Never a formatted string, never pre-divided by 10^6: the display unit and precision belong to report-spec."
          },
          "triangle_count": { "type": "integer", "minimum": 0 },
          "shell_count": { "type": "integer", "minimum": 0 },
          "closed_manifold": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "metrics": {
      "type": "object",
      "description": "Measurements that are not per-solid (intersections, misses, distances), with their units carried by this result's units block."
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "value", "threshold", "pass", "measured"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "value": {},
          "threshold": {},
          "pass": { "type": "boolean" },
          "measured": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "path", "bytes", "sha256"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "minLength": 16 }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
